# Sela API Configuration
SELA_API_KEY=your_sela_api_key_here
SELA_API_BASE_URL=https://api.selanetwork.io
# Slack Configuration
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CHANNEL=market-intelligence

# AI Summarization Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# AI Provider: "gemini", "claude", or "both"
AI_PROVIDER=gemini

# Enable AI Summaries: true or false
ENABLE_AI_SUMMARIES=true
